# Postgres connection string (get a free one from Neon, Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Password required to add/edit/delete products in /admin
ADMIN_PASSWORD="choose-a-strong-password"

# Created automatically when you add "Blob" storage in your Vercel project
# (Storage tab -> Create Database -> Blob). Needed for photo uploads.
BLOB_READ_WRITE_TOKEN=""
