# Postgres connection string (from Supabase: use the Transaction pooler URL)
DATABASE_URL="postgresql://postgres.xxxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Password required to add/edit/delete products in /admin
ADMIN_PASSWORD="choose-a-strong-password"

# From Supabase dashboard: Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# From console.anthropic.com, powers the floating site helper chat
ANTHROPIC_API_KEY=""

# Powers "Request a Quote" (cart checkout) email notifications.
# From resend.com -> API Keys. Free tier is fine to start.
RESEND_API_KEY=""

# Sender address for quote emails. Must be on a domain you've verified in
# Resend (Resend dashboard -> Domains). Until you verify a domain, you can
# leave this unset to use Resend's shared sandbox sender, which only reliably
# delivers to the email address you signed up to Resend with.
EMAIL_FROM="Pulse & Plug <orders@yourdomain.com>"

# Where new cart quote requests are emailed. Defaults to pulsendplug@gmail.com
# if not set.
NOTIFY_EMAIL="pulsendplug@gmail.com"
