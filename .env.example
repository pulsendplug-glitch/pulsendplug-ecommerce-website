# Postgres connection string (from Supabase: use the Transaction pooler URL)
DATABASE_URL="postgresql://postgres.xxxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Password required to add/edit/delete products in /admin
ADMIN_PASSWORD="choose-a-strong-password"

# From Supabase dashboard: Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# From console.anthropic.com, powers the floating site helper chat
ANTHROPIC_API_KEY=""
